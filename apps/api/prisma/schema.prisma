datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  customDomain String?       @unique @map("custom_domain")
  planId       String?       @map("plan_id")
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  memberships      TenantMembership[]
  boards           Board[]
  feedbacks        Feedback[]
  votes            Vote[]
  comments         Comment[]
  roadmapItems     RoadmapItem[]
  endCustomers     EndCustomer[]
  changelogEntries ChangelogEntry[]
  subscriptions    Subscription[]
  webhookEndpoints WebhookEndpoint[]

  @@map("tenants")
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String             @map("password_hash")
  name         String
  avatarUrl    String?            @map("avatar_url")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  memberships  TenantMembership[]

  @@map("users")
}

model TenantMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("MEMBER")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model EndCustomer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("end_customers")
}

model Board {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  name        String
  slug        String
  description String?
  isPrivate   Boolean    @default(false) @map("is_private")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedbacks   Feedback[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("boards")
}

model Feedback {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  boardId     String         @map("board_id")
  title       String
  description String
  status      String         @default("OPEN")
  voteCount   Int            @default(0) @map("vote_count")
  authorId    String         @map("author_id")
  authorName  String         @default("Anonim") @map("author_name")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  votes       Vote[]
  comments    Comment[]
  roadmapItem RoadmapItem?

  @@index([tenantId])
  @@index([boardId])
  @@map("feedbacks")
}

model Vote {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  feedbackId String   @map("feedback_id")
  voterId    String   @map("voter_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, voterId])
  @@index([tenantId])
  @@map("votes")
}

model Comment {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  feedbackId String    @map("feedback_id")
  authorId   String    @map("author_id")
  authorName String    @map("author_name")
  body       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([feedbackId])
  @@map("comments")
}

model RoadmapItem {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  feedbackId  String?       @unique @map("feedback_id")
  title       String
  description String?
  status      String        @default("PLANNED")
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback    Feedback?     @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("roadmap_items")
}

model Plan {
  id             String   @id @default(uuid())
  name           String   @unique
  priceMonth     Int      @default(0) @map("price_month")
  maxBoards      Int      @default(1) @map("max_boards")
  maxTeamMembers Int      @default(1) @map("max_team_members")
  maxCustomers   Int      @default(100) @map("max_customers")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("plans")
}

model ChangelogEntry {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  title       String
  body        String
  version     String?
  category    String    @default("IMPROVEMENT")
  isPublished Boolean   @default(true) @map("is_published")
  publishedAt DateTime  @default(now()) @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("changelog_entries")
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  planId               String    @default("FREE") @map("plan_id")
  status               String    @default("ACTIVE")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  url       String
  secret    String
  events    String       @default("[\"*\"]")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs      WebhookLog[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookLog {
  id         String          @id @default(uuid())
  endpointId String          @map("endpoint_id")
  event      String
  payload    String
  statusCode Int?            @map("status_code")
  success    Boolean         @default(false)
  createdAt  DateTime        @default(now()) @map("created_at")

  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@map("webhook_logs")
}
